{
  "nightfallSaves": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      "slot1": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['schemaVersion','worldVersion','playSeconds','player','selected','inventory','revision','updatedAt'])",
        "schemaVersion": {
          ".validate": "newData.val() === 1"
        },
        "worldVersion": {
          ".validate": "newData.val() === 6"
        },
        "playSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "selected": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 === 0"
        },
        "revision": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "player": {
          ".validate": "newData.hasChildren(['x','z','health','armor','wallet'])",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -3390 && newData.val() <= 3390"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() >= -3390 && newData.val() <= 3390"
          },
          "health": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "armor": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "wallet": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
          },
          "$other": {
            ".validate": false
          }
        },
        "inventory": {
          ".validate": "newData.hasChildren(['0','1','2','3'])",
          "$index": {
            ".validate": "($index === '0' || $index === '1' || $index === '2' || $index === '3' || $index === '4') && newData.hasChildren(['owned','ammo','reserve'])",
            "owned": {
              ".validate": "newData.isBoolean()"
            },
            "ammo": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
            },
            "reserve": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "defeatedEnemyIds": {
          "$index": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 499 && newData.val() % 1 === 0"
          }
        },
        "$other": {
          ".validate": false
        },
        "civic": {
          ".validate": "newData.hasChildren(['civilianKills','chiefDown','dawn','justice','justiceTime','escaped'])",
          "civilianKills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "chiefDown": {
            ".validate": "newData.isBoolean()"
          },
          "dawn": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "justice": {
            ".validate": "newData.val() === 'free' || newData.val() === 'wanted' || newData.val() === 'station' || newData.val() === 'court' || newData.val() === 'prison'"
          },
          "justiceTime": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "escaped": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  },
  "nightfallRooms": {
    ".read": false,
    "$room": {
      ".read": "auth != null",
      ".write": "auth != null && ((!data.exists() && $room.matches(/^[A-Z2-9]{6}$/) && newData.child('meta/host').val() === auth.uid && newData.child('meta/version').val() === 13 && newData.child('slots/0').val() === auth.uid) || (!newData.exists() && data.child('meta/host').val() === auth.uid))",
      ".validate": "newData.hasChildren(['meta','slots'])",
      "meta": {
        ".validate": "newData.hasChildren(['host','version','createdAt'])",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "version": {
          ".validate": "newData.val() === 13"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      },
      "slots": {
        ".validate": "newData.numChildren() <= 4",
        "$slot": {
          ".write": "auth != null && $slot.matches(/^[0-3]$/) && ((!newData.exists() && data.val() === auth.uid) || (newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && root.child('nightfallRooms').child($room).child('meta/version').val() === 13 && root.child('nightfallRooms').child($room).child('slots/0').exists() && ($slot !== '0' || root.child('nightfallRooms').child($room).child('meta/host').val() === auth.uid)))",
          ".validate": "$slot.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 128"
        }
      },
      "players": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('nightfallRooms').child($room).child('slots/0').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/1').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/2').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/3').val() === auth.uid))",
          ".validate": "newData.hasChildren(['x','y','z','yaw','pitch','hp','weapon','active','shot','vehicle','speed','name','updatedAt'])",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -3390 && newData.val() <= 3390"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= -30 && newData.val() <= 600"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() >= -3390 && newData.val() <= 3390"
          },
          "yaw": {
            ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000"
          },
          "pitch": {
            ".validate": "newData.isNumber() && newData.val() >= -1.5 && newData.val() <= 1.5"
          },
          "hp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "weapon": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          },
          "shot": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
          },
          "vehicle": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 199"
          },
          "speed": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "inputs": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('nightfallRooms').child($room).child('slots/0').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/1').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/2').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/3').val() === auth.uid))",
          ".validate": "newData.numChildren() <= 8",
          "$slot": {
            ".validate": "$slot.matches(/^[0-7]$/) && newData.hasChildren(['seq','weapon','origin','direction','at'])",
            "seq": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "weapon": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
            },
            "origin": {
              ".validate": "newData.hasChildren(['x','y','z'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -3400 && newData.val() <= 3400"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -30 && newData.val() <= 610"
              },
              "z": {
                ".validate": "newData.isNumber() && newData.val() >= -3400 && newData.val() <= 3400"
              },
              "$other": {
                ".validate": false
              }
            },
            "direction": {
              ".validate": "newData.hasChildren(['x','y','z'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -1.5 && newData.val() <= 1.5"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -1.5 && newData.val() <= 1.5"
              },
              "z": {
                ".validate": "newData.isNumber() && newData.val() >= -1.5 && newData.val() <= 1.5"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "claims": {
        "$vehicle": {
          ".write": "auth != null && ((!newData.exists() && data.val() === auth.uid) || (newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && (root.child('nightfallRooms').child($room).child('slots/0').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/1').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/2').val() === auth.uid || root.child('nightfallRooms').child($room).child('slots/3').val() === auth.uid)))",
          ".validate": "$vehicle.matches(/^(1[0-9]{2}|[1-9]?[0-9])$/) && newData.isString()"
        }
      },
      "damage": {
        "$uid": {
          ".write": "auth != null && root.child('nightfallRooms').child($room).child('meta/host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        }
      },
      "world": {
        ".write": "auth != null && root.child('nightfallRooms').child($room).child('meta/host').val() === auth.uid",
        ".validate": "newData.hasChildren(['version','t','active','vehicles','chief','dawn','updatedAt'])",
        "version": {
          ".validate": "newData.val() === 13"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "chief": {
          ".validate": "newData.isBoolean()"
        },
        "dawn": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 1000"
        },
        "actors": {
          ".validate": "newData.numChildren() <= 1000",
          "$row": {
            ".validate": "newData.numChildren() === 9",
            "$n": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            }
          }
        },
        "vehicles": {
          ".validate": "newData.numChildren() <= 200",
          "$row": {
            ".validate": "newData.numChildren() === 12",
            "$n": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            }
          }
        },
        "dead": {
          ".validate": "newData.numChildren() <= 1000",
          "$n": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          }
        },
        "$other": {
          ".validate": false
        },
        "fires": {
          ".validate": "newData.numChildren() <= 16",
          "$row": {
            ".validate": "newData.numChildren() === 5",
            "$n": {
              ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
            }
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
